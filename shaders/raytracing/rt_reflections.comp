#version 450
// RT reflections: GGX VNDF-sampled closest-hit rays, shaded hits. docs/raytracing_reflections.md
layout(local_size_x = 8, local_size_y = 8) in;
#include "raytracing/rt_common.glsl"
#include "raytracing/rt_gbuffer.glsl"
layout(binding = 0, rgba16f) uniform writeonly image2D uOut; // rgb reflected radiance, a hit distance (-1 = skipped)

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(px, sizes.xy))) return;
    GSample g = loadG(fullTexel(px));
    if (!g.valid || g.roughness > effectParams.y) { imageStore(uOut, px, vec4(0.0, 0.0, 0.0, -1.0)); return; }
    Rng rng = rngInit(uvec2(px), uint(frameInfo.x), 3u);
    vec3 V = normalize(camPos.xyz - g.pos);
    int rays = max(frameInfo.y, 1);
    int bounces = clamp(frameInfo.z, 1, 2);
    vec3 sum = vec3(0.0);
    float hitDist = 0.0;
    for (int i = 0; i < rays; ++i) {
        float alpha = g.roughness * g.roughness;
        vec3 H = alpha < 0.002 ? g.n : sampleGGXVNDF(V, g.n, alpha, rand2(rng));
        vec3 R = reflect(-V, H);
        if (dot(R, g.n) <= 0.0) R = reflect(-V, g.n);
        vec3 o = offsetOrigin(g.pos, g.n);
        vec3 throughput = vec3(1.0);
        vec3 radiance = vec3(0.0);
        for (int b = 0; b < bounces; ++b) {
            Hit h;
            if (!traceClosest(o, R, effectParams.z, h)) { radiance += throughput * skyRadiance(R); if (b == 0) hitDist += effectParams.z; break; }
            if (b == 0) hitDist += h.t;
            Surface s = surfaceAt(o, R, h);
            vec3 Vh = -R;
            radiance += throughput * (s.emissive + shadeSunAt(s, Vh, rng) + s.albedo * (1.0 - s.metallic) * skyZenith.rgb * 0.25);
            // second bounce: mirror off the hit (only matters for shiny hits)
            vec3 F0 = mix(vec3(0.04), s.albedo, s.metallic);
            throughput *= fresnelSchlick(max(dot(s.n, Vh), 0.0), F0) * (1.0 - s.roughness);
            if (max(throughput.r, max(throughput.g, throughput.b)) < 0.01) break;
            R = reflect(R, s.n);
            o = offsetOrigin(s.pos, s.n);
        }
        sum += radiance;
    }
    imageStore(uOut, px, vec4(sum / float(rays), hitDist / float(rays)));
}
