#version 450
// contact_shadows.comp - short screen-space ray march toward the sun (docs/shadows.md)
#include "lighting/lighting_common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 3) uniform sampler2D uDepth;
layout(r8, binding = 0) uniform writeonly image2D uOut;
layout(std140, binding = 3) uniform ContactPass { vec4 uParams; };  // x max distance (m), y thickness (m), z steps

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(px, ivec2(uRenderSize.xy)))) return;
    vec2 uv = (vec2(px) + 0.5) * uRenderSize.zw;
    float d = texelFetch(uDepth, px, 0).r;
    if (isSky(d)) { imageStore(uOut, px, vec4(1)); return; }
    vec3 P = viewPosFromDepth(uv, d);
    vec3 L = normalize(mat3(uView) * sunDir());
    int steps = int(uParams.z);
    float stepLen = uParams.x / float(steps);
    float jitter = ign(vec2(px), frameIndex());
    float occ = 0.0;
    vec3 ray = P + L * stepLen * jitter;
    for (int i = 0; i < steps; ++i) {
        ray += L * stepLen;
        vec3 s = projectView(ray);
        if (any(lessThan(s.xy, vec2(0))) || any(greaterThan(s.xy, vec2(1)))) break;
        float sceneZ = viewPosFromDepth(s.xy, textureLod(uDepth, s.xy, 0).r).z;
        float delta = sceneZ - ray.z;            // > 0 : scene is in front of the ray
        if (delta > 0.02 * stepLen && delta < uParams.y) {
            // fade near screen edges
            vec2 e = smoothstep(vec2(0.0), vec2(0.05), s.xy) * smoothstep(vec2(0.0), vec2(0.05), 1.0 - s.xy);
            occ = e.x * e.y;
            break;
        }
    }
    imageStore(uOut, px, vec4(1.0 - occ));
}
