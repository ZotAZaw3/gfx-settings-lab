#version 450
// Path tracer: camera rays, cosine diffuse + GGX VNDF specular + dielectric transmission,
// next-event estimation to the sun, Russian roulette, progressive accumulation. docs/path_tracing.md
layout(local_size_x = 8, local_size_y = 8) in;
#include "raytracing/rt_common.glsl"
#include "raytracing/rt_gbuffer.glsl"
layout(binding = 0, rgba32f) uniform image2D uAccum;          // running mean, a = sample count
layout(binding = 1, rgba16f) uniform writeonly image2D uOut;   // demodulated estimate, a = variance proxy
layout(binding = 2, rgba16f) uniform writeonly image2D uAlbedo; // primary-hit albedo (for demodulation / rt.albedo)

vec3 tracePath(vec3 o, vec3 d, inout Rng rng, inout vec3 primaryAlbedo) {
    vec3 radiance = vec3(0.0), throughput = vec3(1.0);
    int maxBounces = max(frameInfo.z, 1);
    for (int bounce = 0; bounce <= maxBounces; ++bounce) {
        Hit h;
        if (!traceClosest(o, d, RT_INF, h)) {
            radiance += throughput * skyRadiance(d);
            break;
        }
        Surface s = surfaceAt(o, d, h);
        if (bounce == 0) primaryAlbedo = s.albedo;
        vec3 V = -d;
        vec3 Ng = faceNormal(h.tri);
        bool entering = dot(Ng, d) < 0.0;

        radiance += throughput * s.emissive;
        if (bounce == maxBounces) break;

        vec3 F0 = mix(vec3(0.04), s.albedo, s.metallic);
        float NdotV = max(dot(s.n, V), 1e-4);
        vec3 F = fresnelSchlick(NdotV, F0);
        float pSpec = clamp(luminance(F), 0.05, 0.95);

        // ---- Transmission (dielectric glass): Fresnel picks reflect vs refract
        if (s.transmission > 0.0 && rand1(rng) < s.transmission) {
            float eta = entering ? 1.0 / s.ior : s.ior;
            vec3 n = entering ? s.n : -s.n;
            n = dot(n, d) < 0.0 ? n : -n;
            float cosI = clamp(dot(-d, n), 0.0, 1.0);
            float Fd = fresnelSchlick(cosI, vec3(pow((1.0 - s.ior) / (1.0 + s.ior), 2.0))).r;
            vec3 T = refract(d, n, eta);
            if (dot(T, T) == 0.0 || rand1(rng) < Fd) { d = reflect(d, n); o = s.pos + n * 1e-3; }
            else { d = normalize(T); o = s.pos - n * 1e-3; throughput *= s.albedo; } // tinted glass
            continue;
        }

        // ---- Next-event estimation: sun with a shadow ray
        radiance += throughput * shadeSunAt(s, V, rng);

        // ---- BSDF sampling: specular (GGX VNDF) or diffuse (cosine)
        float alpha = s.roughness * s.roughness;
        if (rand1(rng) < pSpec) {
            vec3 H = sampleGGXVNDF(V, s.n, alpha, rand2(rng));
            vec3 L = reflect(-V, H);
            float NdotL = dot(s.n, L);
            if (NdotL <= 0.0) break;
            throughput *= fresnelSchlick(max(dot(V, H), 0.0), F0) * smithG1(NdotL, alpha) / pSpec;
            d = L;
        } else {
            d = sampleCosineHemisphere(s.n, rand2(rng));
            throughput *= s.albedo * (1.0 - s.metallic) / (1.0 - pSpec);
        }
        o = offsetOrigin(s.pos, s.n);

        // ---- Russian roulette after 2 bounces
        if ((frameInfo.w & RT_FLAG_RUSSIAN_ROULETTE) != 0 && bounce >= 2) {
            float p = clamp(max(throughput.r, max(throughput.g, throughput.b)), 0.05, 0.95);
            if (rand1(rng) > p) break;
            throughput /= p;
        }
    }
    return radiance;
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(px, sizes.xy))) return;
    int spp = max(frameInfo.y, 1);
    vec3 sum = vec3(0.0);
    vec3 primaryAlbedo = vec3(1.0); // sky
    for (int s = 0; s < spp; ++s) {
        Rng rng = rngInit(uvec2(px), uint(frameInfo.x), 100u + uint(s));
        vec2 jitter = rand2(rng);                                // per-sample sub-pixel AA
        vec2 uv = (vec2(px) + jitter) / vec2(sizes.xy);
        vec3 o, d;
        cameraRay(uv, o, d);
        vec3 L = tracePath(o, d, rng, primaryAlbedo);
        if ((frameInfo.w & RT_FLAG_FIREFLY_CLAMP) != 0) L = min(L, vec3(32.0));
        if (any(isnan(L)) || any(isinf(L))) L = vec3(0.0);
        sum += L;
    }
    vec3 cur = sum / float(spp);
    vec4 acc = imageLoad(uAccum, px);
    float n = ((frameInfo.w & RT_FLAG_ACCUMULATE) != 0 && (frameInfo.w & RT_FLAG_HISTORY_VALID) != 0) ? acc.a : 0.0;
    vec3 mean = (acc.rgb * n + cur) / (n + 1.0);
    imageStore(uAccum, px, vec4(mean, n + 1.0));
    // Output is demodulated (radiance / primary albedo) so the a-trous filter keeps texture detail;
    // rt_composite.frag (COMPOSITE_PT) multiplies albedo back. a = variance proxy for the filter:
    // high while few samples are accumulated, shrinking as 1/n.
    vec3 alb = max(primaryAlbedo, vec3(0.02));
    vec3 demod = mean / alb;
    float l = luminance(demod);
    imageStore(uOut, px, vec4(demod, l * l / (n + 1.0)));
    imageStore(uAlbedo, px, vec4(alb, 1.0));
}
