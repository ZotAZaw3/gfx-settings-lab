#version 450
// sky_to_cube.comp - procedural HDR sky (analytic gradient + sun disc) into a cubemap.
// Swap for an equirect HDR by sampling it with dirToEquirect(). (docs/reflections.md, step 1)
#include "lighting/lighting_common.glsl"
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(rgba16f, binding = 0) uniform writeonly imageCube uCube;
layout(binding = 6) uniform sampler2D uEquirect;
layout(std140, binding = 3) uniform SkyPass { ivec4 uSky; };   // x = use equirect, y = first face (dispatch z = face count)
#define uUseEquirect uSky.x

vec3 proceduralSky(vec3 d) {
    vec3 sun = sunDir();
    float h = d.y;
    vec3 zenith = vec3(0.18, 0.36, 0.80), horizon = vec3(0.70, 0.80, 0.95), ground = vec3(0.25, 0.22, 0.20);
    vec3 c = h > 0.0 ? mix(horizon, zenith, pow(h, 0.5)) : mix(horizon, ground, pow(-h, 0.4));
    float mu = max(dot(d, sun), 0.0);
    vec3 sunC = sunRadiance();
    c += sunC * (pow(mu, 8.0) * 0.05 + pow(mu, 64.0) * 0.2);
    if (mu > cos(max(uSunColor.w, 0.0047))) c += sunC * 20.0;   // disc
    return c * 0.6;   // sky irradiance ~1/5 of the sun (6), like a clear day
}
void main() {
    ivec3 id = ivec3(gl_GlobalInvocationID) + ivec3(0, 0, uSky.y);
    int size = imageSize(uCube).x;
    if (id.x >= size || id.y >= size) return;
    vec3 d = cubeDir(id, float(size));
    vec3 c;
    if (uUseEquirect != 0) {
        vec2 uv = vec2(atan(d.z, d.x) / (2.0 * PI) + 0.5, acos(clamp(d.y, -1.0, 1.0)) / PI);
        c = textureLod(uEquirect, uv, 0.0).rgb;
    } else c = proceduralSky(d);
    imageStore(uCube, id, vec4(c, 1));
}
