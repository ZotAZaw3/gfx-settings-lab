#version 450
// SVGF step 1: temporal accumulation with depth-based disocclusion test and luminance moments.
// Output rgb = accumulated signal, a = variance. docs/denoising.md
layout(local_size_x = 8, local_size_y = 8) in;
#include "raytracing/rt_common.glsl"
#include "raytracing/rt_gbuffer.glsl"
layout(binding = 4) uniform sampler2D uNoisy;        // this frame's raw signal (trace res)
layout(binding = 5) uniform sampler2D uHistory;      // last frame's accumulated signal
layout(binding = 6) uniform sampler2D uHistMoments;  // r m1, g m2, b history length, a depth at write time
layout(binding = 0, rgba16f) uniform writeonly image2D uOut;
layout(binding = 1, rgba16f) uniform writeonly image2D uMoments;

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(px, sizes.xy))) return;
    GSample g = loadG(fullTexel(px));
    vec3 cur = texelFetch(uNoisy, px, 0).rgb;
    float l = luminance(cur);
    vec2 m = vec2(l, l * l);
    float len = 1.0;
    vec3 outC = cur;

    if (g.valid && (frameInfo.w & RT_FLAG_HISTORY_VALID) != 0) {
        vec4 c = prevViewProj * vec4(g.pos, 1.0);
        vec2 ndc = c.xy / c.w;
        vec2 uv = vec2(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5);
        if (c.w > 0.0 && all(greaterThanEqual(uv, vec2(0.0))) && all(lessThanEqual(uv, vec2(1.0)))) {
            ivec2 ppx = clamp(ivec2(uv * vec2(sizes.xy)), ivec2(0), sizes.xy - 1);
            vec4 hm = texelFetch(uHistMoments, ppx, 0);
            float expectedDepth = c.z / c.w;
            // reversed-Z depth is ~1/z, so compare relative difference
            bool sameSurface = abs(hm.a - expectedDepth) <= denoiseParams.z * max(expectedDepth, 1e-6);
            if (sameSurface) {
                len = min(hm.b + 1.0, 32.0);
                float alpha = max(1.0 / len, denoiseParams.x);
                vec3 hist = textureLod(uHistory, uv, 0.0).rgb;
                outC = mix(hist, cur, alpha);
                m = mix(hm.rg, m, alpha);
            }
        }
    }
    float variance = max(m.y - m.x * m.x, 0.0);
    if (len < 4.0) variance = max(variance, 1.0 / len); // young history: assume noisy, blur more
    imageStore(uOut, px, vec4(outC, variance));
    imageStore(uMoments, px, vec4(m, len, g.depth));
}
