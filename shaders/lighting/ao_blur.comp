#version 450
// ao_blur.comp - separable depth-aware (bilateral) blur; run twice (H then V)
#include "lighting/lighting_common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 3) uniform sampler2D uDepth;
layout(binding = 5) uniform sampler2D uAOIn;
layout(r8, binding = 0) uniform writeonly image2D uAOOut;
layout(std140, binding = 3) uniform BlurPass { vec4 uBlurA; ivec4 uBlurB; };  // A: xy size, zw dir; B: x radius
#define uOutSize uBlurA.xy
#define uDir uBlurA.zw
#define uRadius uBlurB.x

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(vec2(px), uOutSize))) return;
    vec2 uv = (vec2(px) + 0.5) / uOutSize;
    float zc = viewPosFromDepth(uv, max(textureLod(uDepth, uv, 0.0).r, 1e-7)).z;
    float sum = 0.0, wsum = 0.0;
    float sigma = float(uRadius) * 0.5 + 0.5;
    for (int i = -uRadius; i <= uRadius; ++i) {
        vec2 suv = uv + uDir * float(i) / uOutSize;
        float z = viewPosFromDepth(suv, max(textureLod(uDepth, suv, 0.0).r, 1e-7)).z;
        float w = exp(-float(i * i) / (2.0 * sigma * sigma)) * exp(-abs(z - zc) * 8.0 / max(abs(zc), 1.0));
        sum += textureLod(uAOIn, suv, 0.0).r * w;
        wsum += w;
    }
    imageStore(uAOOut, px, vec4(sum / max(wsum, 1e-5)));
}
