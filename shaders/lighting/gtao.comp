#version 450
// gtao.comp - ground-truth AO (Jimenez 2016): analytic cosine-weighted integral per slice
#include "lighting/lighting_common.glsl"
#include "lighting/ao_common.glsl"

float integrateArc(float h1, float h2, float n) {
    float sn = sin(n), cn = cos(n);
    return 0.25 * (-cos(2.0 * h1 - n) + cn + 2.0 * h1 * sn)
         + 0.25 * (-cos(2.0 * h2 - n) + cn + 2.0 * h2 * sn);
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(vec2(px), uOutSize))) return;
    vec2 uv = (vec2(px) + 0.5) / uOutSize;
    float d = textureLod(uDepth, uv, 0.0).r;
    if (isSky(d)) { imageStore(uAOOut, px, vec4(1)); return; }
    vec3 P = viewPosFromDepth(uv, d);
    vec3 N = aoViewNormal(uv);
    vec3 V = normalize(-P);
    float radius = uAOParams.x;
    float radiusPx = min(radius * projScale() / -P.z, 192.0) * uOutSize.y * uRenderSize.w;
    if (radiusPx < 1.0) { imageStore(uAOOut, px, vec4(1)); return; }
    int slices = uAOCfg.y, steps = uAOCfg.z;
    float noiseDir = ign(vec2(px), frameIndex());
    float noiseOff = fract(noiseDir * 7.31 + 0.618 * float(frameIndex() & 15));
    float vis = 0.0;
    for (int s = 0; s < slices; ++s) {
        float phi = PI * (float(s) + noiseDir) / float(slices);
        vec2 dir2 = vec2(cos(phi), sin(phi));
        // slice plane in view space (screen y down => view y up)
        vec3 dirV = vec3(dir2.x, -dir2.y, 0.0);
        vec3 ortho = dirV - dot(dirV, V) * V;
        vec3 axis = normalize(cross(dirV, V));
        vec3 projN = N - axis * dot(N, axis);
        float projLen = length(projN);
        float sgn = sign(dot(ortho, projN));              // XeGTAO convention
        float n = sgn * acos(clamp(dot(projN, V) / max(projLen, 1e-4), -1.0, 1.0));
        float c1 = -1.0, c2 = -1.0;   // cos of horizon angles, both sides
        for (int j = 0; j < steps; ++j) {
            float t = (float(j) + noiseOff) / float(steps);
            t = t * t * radiusPx + 1.0;
            vec2 off = dir2 * t / uOutSize;
            vec3 h1 = aoViewPos(uv + off) - P;
            vec3 h2 = aoViewPos(uv - off) - P;
            float l1 = length(h1), l2 = length(h2);
            float f1 = clamp(1.0 - l1 * l1 / (radius * radius), 0.0, 1.0);
            float f2 = clamp(1.0 - l2 * l2 / (radius * radius), 0.0, 1.0);
            c1 = max(c1, mix(-1.0, dot(h1, V) / max(l1, 1e-4), f1));
            c2 = max(c2, mix(-1.0, dot(h2, V) / max(l2, 1e-4), f2));
        }
        // c1 = +direction side (positive angle), c2 = -direction side (negative angle)
        float h0 = n + clamp(-acos(c2) - n, -PI * 0.5, PI * 0.5);
        float h1 = n + clamp( acos(c1) - n, -PI * 0.5, PI * 0.5);
        vis += projLen * integrateArc(h0, h1, n);
    }
    vis /= float(slices);
    imageStore(uAOOut, px, vec4(clamp(vis, 0.0, 1.0)));
}
